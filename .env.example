# =============================================================================
# Required on Vercel (Production + Preview)
# =============================================================================

# MongoDB Atlas connection string (allow Vercel IPs / 0.0.0.0 in Network Access)
MONGODB_URI=

# JWT signing secret for admin session cookies (long random string, e.g. openssl rand -hex 32)
AUTH_SECRET=

# Public site origin for CSRF Origin checks (your custom domain, e.g. https://ahmixen.com)
# Also used as an allowlist host alongside x-forwarded-host and Vercel URLs
# Required for absolute links in reservation confirmation emails
SITE_URL=

# =============================================================================
# Email (reservation confirmation)
# =============================================================================

# "log" prints emails to the server console; "smtp" sends via SMTP (default: log outside production)
EMAIL_MODE=

# SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for implicit TLS)
SMTP_PORT=

# true = implicit TLS (465); false = STARTTLS (587)
SMTP_SECURE=

# SMTP login username (usually the mailbox address)
SMTP_USER=

# SMTP password or app password (spaces are stripped; never commit real values)
SMTP_PASS=

# From header, e.g. AhmiXen <you@domain.com>
EMAIL_FROM=

# Optional Reply-To address for customer questions
EMAIL_REPLY_TO=

# Optional comma-separated allowlist; outside production only these (or SMTP_USER) may receive mail
EMAIL_ALLOWLIST=

# Max confirmation emails marked sent in a rolling 24 hours (default 400)
EMAIL_DAILY_LIMIT=

# =============================================================================
# Optional
# =============================================================================

# Checkout seat hold duration in minutes (server-only; default 30)
# Browser reads holdMinutes from GET /api/public/checkout — no NEXT_PUBLIC copy
CHECKOUT_HOLD_MINUTES=

# Optional salt for hashing IPs / identities in rateLimits (falls back to AUTH_SECRET)
RATE_LIMIT_SALT=

# One-time admin seed (local / one-off): npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Allow seed/migrate/test scripts against production or non-dev-looking DB names
ALLOW_SEED=

# Base URL for npm run test:checkout (development only; default http://localhost:3000)
BASE_URL=

# Public API rate limits (optional; defaults in src/lib/public/rateLimitConfig.ts)
RATE_LIMIT_CHECKOUT_IP=
RATE_LIMIT_CHECKOUT_WINDOW=
RATE_LIMIT_LEADS_IP=
RATE_LIMIT_LEADS_IP_WINDOW=
RATE_LIMIT_LEADS_EMAIL=
RATE_LIMIT_LEADS_EMAIL_WINDOW=
RATE_LIMIT_COUPONS_IP=
RATE_LIMIT_COUPONS_IP_WINDOW=
RATE_LIMIT_COUPONS_EMAIL=
RATE_LIMIT_COUPONS_EMAIL_WINDOW=
RATE_LIMIT_ORDERS_IP=
RATE_LIMIT_ORDERS_IP_WINDOW=
RATE_LIMIT_ORDERS_EMAIL=
RATE_LIMIT_ORDERS_EMAIL_WINDOW=
RATE_LIMIT_ORDER_STATUS_IP=
RATE_LIMIT_ORDER_STATUS_WINDOW=
RATE_LIMIT_PAYMENT_INFO_IP=
RATE_LIMIT_PAYMENT_INFO_WINDOW=
RATE_LIMIT_PROOF_IP=
RATE_LIMIT_PROOF_IP_WINDOW=
RATE_LIMIT_PROOF_TOKEN=
RATE_LIMIT_PROOF_TOKEN_WINDOW=

# Set automatically by Vercel (used by Origin allowlist; do not set manually)
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
